# Copy to .env for the disposable Docker demo. Choose a URL-safe database password.
DEMO_DB_PASSWORD=replace-with-unique-demo-password
DEMO_PUBLIC_API_URL=http://localhost:4001
DEMO_WEB_ORIGIN=http://localhost:3000
# Public Compose deployment expects one trusted HTTPS reverse proxy that overwrites X-Forwarded-For.
# Use 0 only for direct local access.
DEMO_TRUST_PROXY_HOPS=1

# Optional signed CRM booking confirmation webhook.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
