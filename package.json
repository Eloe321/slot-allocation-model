{
  "name": "slot-allocation-remodel",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @slot/engine build",
    "setup": "pnpm install && pnpm build && pnpm --filter @slot/api db:migrate && pnpm --filter @slot/api db:seed",
    "dev": "pnpm --filter @slot/api dev",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
